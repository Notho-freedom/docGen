# Configuration docGen AI
# Copiez ce fichier vers .env et remplissez vos valeurs

# =============================================================================
# GROQ API CONFIGURATION
# =============================================================================

# Clé API Groq (obligatoire pour l'enrichissement IA)
# Obtenez votre clé sur https://console.groq.com/
GROQ_API_KEY=votre_clé_api_groq_ici

# Modèle Groq à utiliser (optionnel)
# Options disponibles: llama3-70b-8192, mixtral-8x7b-32768, gemma2-9b-it
GROQ_MODEL=llama3-70b-8192

# Température pour la génération (0.0 = déterministe, 1.0 = créatif)
GROQ_TEMPERATURE=0.3

# Nombre maximum de tokens par réponse
GROQ_MAX_TOKENS=1000

# =============================================================================
# DOCUMENTATION CONFIGURATION
# =============================================================================

# Langue de sortie pour la documentation
DOC_LANGUAGE=fr

# Format de sortie par défaut (markdown, html, json)
DEFAULT_FORMAT=markdown

# Activer l'enrichissement IA par défaut
ENABLE_AI_ENHANCEMENT=true

# =============================================================================
# QUALITY ANALYSIS CONFIGURATION
# =============================================================================

# Complexité cyclomatique maximale acceptable
MAX_COMPLEXITY=10

# Couverture de documentation minimale (en pourcentage)
MIN_DOC_COVERAGE=80.0

# Activer le cache pour améliorer les performances
ENABLE_CACHE=true

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Niveau de log (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Activer les logs détaillés
VERBOSE_LOGGING=false

# =============================================================================
# ADVANCED CONFIGURATION
# =============================================================================

# Timeout pour les appels API (en secondes)
API_TIMEOUT=30

# Nombre de tentatives en cas d'échec API
API_RETRIES=3

# Activer la validation stricte des données
STRICT_VALIDATION=false

# =============================================================================
# TTS CONFIGURATION (optionnel)
# =============================================================================

# Endpoints TTS pour la génération audio
TTS_VOICES_ENDPOINT=https://low-tts.onrender.com/api/voices-by-text
TTS_GENERATE_ENDPOINT=https://low-tts.onrender.com/api/tts

# Timeout TTS (en secondes)
TTS_TIMEOUT=30

# Voix préférées (codes de langue)
TTS_VOICE_PREFERENCE=fr-FR,en-US

# Volume audio (0.0 à 1.0)
AUDIO_VOLUME=0.8 